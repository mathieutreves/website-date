node_modules/
dist/
coverage/
*.tsbuildinfo

# Third-party evaluation corpus, downloaded on demand by
# scripts/fetch-htmldate-corpus.ts. Not vendored: it is ~40 MB of other
# people's HTML under no license we control.
corpus-external/

# WXT / extension build output
.wxt/
.output/
web-ext-artifacts/

# Generated store screenshots. `pnpm gen:screenshots` rebuilds them from the
# real UI in seconds, and the captured PNGs live in the store listing rather
# than here.
apps/extension/screenshots/

# editor / OS
.DS_Store
*.log
.idea/
.vscode/*
!.vscode/extensions.json

# Local Python venv for the htmldate comparison
.venv-eval/

# Competitor packages for benchmarking, installed on demand
bench/node_modules/
bench/package-lock.json

# Our own benchmark corpus. The manifest IS committed — it is the citable
# artifact, and corpus/cache/ can be rebuilt from it byte-for-byte via
# scripts/corpus/fetch.ts. The HTML itself is other people's, under no license
# we control, so it stays local.
corpus/cache/

# Browser bundle built on demand by bench/parity-browser.mjs.
bench/.pagedate-browser.js
