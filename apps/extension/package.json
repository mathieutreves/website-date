{
  "name": "@website-date/extension",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "gen:locales": "npx tsx scripts/gen-locales.ts",
    "gen:icons": "npx tsx scripts/gen-icons.ts",
    "gen:screenshots": "npx tsx scripts/gen-screenshots.ts",
    "typecheck": "tsc --noEmit",
    "postinstall": "wxt prepare",
    "test": "vitest run"
  },
  "dependencies": {
    "pagedate": "workspace:*"
  },
  "devDependencies": {
    "linkedom": "^0.18.13",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10",
    "wxt": "^0.21.2"
  }
}
