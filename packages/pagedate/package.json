{
  "name": "pagedate",
  "version": "0.1.0",
  "description": "Extract publication and modification dates from web pages, with provenance and confidence. Browser-first, zero runtime dependencies.",
  "author": "Mathieu Treves",
  "homepage": "https://github.com/mathieutreves/website-date#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mathieutreves/website-date.git",
    "directory": "packages/pagedate"
  },
  "bugs": {
    "url": "https://github.com/mathieutreves/website-date/issues"
  },
  "type": "module",
  "license": "MIT",
  "keywords": [
    "date",
    "publication-date",
    "last-modified",
    "metadata",
    "schema.org",
    "opengraph",
    "browser-extension"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./edge": {
      "types": "./dist/edge/index.d.ts",
      "import": "./dist/edge/index.js"
    },
    "./node": {
      "types": "./dist/node/index.d.ts",
      "import": "./dist/node/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "pagedate": "./dist/node/cli.js"
  },
  "files": [
    "dist",
    "NOTICE"
  ],
  "peerDependencies": {
    "linkedom": ">=0.18",
    "node-html-parser": ">=9"
  },
  "peerDependenciesMeta": {
    "linkedom": {
      "optional": true
    },
    "node-html-parser": {
      "optional": true
    }
  },
  "scripts": {
    "build": "tsup && tsc -p tsconfig.build.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "linkedom": "^0.18.13",
    "node-html-parser": "^9.0.0",
    "tsup": "^8.5.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
